# Copia a .env y añade tu clave. Nunca publiques .env.
GEMINI_API_KEY=
GEMINI_DAILY_BUDGET_EUR=3
# Opcional: por defecto usa la zona del país elegido.
# BUDGET_TIMEZONE=Europe/Madrid
# Tu propio ID de Amazon; vacío para no usar afiliación.
AMAZON_ASSOCIATE_TAG=
# Preparado y desactivado. No hay opciones de Telegram en el panel.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
